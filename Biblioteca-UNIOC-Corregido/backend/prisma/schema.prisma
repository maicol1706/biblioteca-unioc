generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IdentitySource {
  LOCAL
  Q10
}

enum AcademicKind {
  STUDENT
  TEACHER
  STAFF
  NONE
}

enum CopyStatus {
  AVAILABLE
  LOANED
  RESERVED
  MAINTENANCE
  LOST
  WITHDRAWN
}

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  QUEUED
  NOTIFIED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum ReminderKind {
  DAYS_BEFORE_7
  DAYS_BEFORE_3
  DAYS_BEFORE_1
  DUE_DAY
  OVERDUE
}

enum ReminderJobStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  LOAN_CREATED
  DUE_SOON
  LOAN_OVERDUE
  RESERVATION_AVAILABLE
  RETURN_REGISTERED
}

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum Q10SyncStatus {
  STARTED
  SUCCESS
  PARTIAL
  FAILED
}

// ---------------------------------------------------------------------------
// Identidad y RBAC
// ---------------------------------------------------------------------------

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique
  passwordHash   String         @map("password_hash")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  documentNumber String?        @unique @map("document_number")
  isActive       Boolean        @default(true) @map("is_active")
  identitySource IdentitySource @default(LOCAL) @map("identity_source")
  externalId     String?        @unique @map("external_id")
  lastLoginAt    DateTime?      @map("last_login_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  profile             UserProfile?
  roles               UserRole[]
  loanRequests        LoanRequest[]      @relation("Requester")
  reviewedRequests    LoanRequest[]      @relation("RequestReviewer")
  loans               Loan[]             @relation("Borrower")
  managedLoans        Loan[]             @relation("LoanLibrarian")
  reservations        Reservation[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settingsUpdated     SystemSetting[]
  conversations       AiConversation[]
  q10Syncs            Q10SyncLog[]

  @@index([isActive])
  @@index([identitySource])
  @@map("users")
}

model UserProfile {
  userId          String        @id @map("user_id") @db.Uuid
  kind            AcademicKind  @default(NONE)
  studentCode     String?       @unique @map("student_code")
  program         String?
  academicStatus  String?       @map("academic_status")
  institutionalEmail String?    @map("institutional_email")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind])
  @@map("user_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  name        String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Publisher {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  books Book[]

  @@map("publishers")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  books Book[]

  @@map("categories")
}

model Author {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name")
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")

  books BookAuthor[]

  @@index([fullName])
  @@map("authors")
}

model Book {
  id                 String   @id @default(uuid()) @db.Uuid
  isbn               String?  @unique
  title              String
  subtitle           String?
  description        String?
  publicationYear    Int?     @map("publication_year")
  edition            String?
  classificationCode String?  @map("classification_code")
  physicalLocation   String?  @map("physical_location")
  coverUrl           String?  @map("cover_url")
  isActive           Boolean  @default(true) @map("is_active")
  publisherId        String?  @map("publisher_id") @db.Uuid
  categoryId         String?  @map("category_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  publisher    Publisher?     @relation(fields: [publisherId], references: [id])
  category     Category?      @relation(fields: [categoryId], references: [id])
  authors      BookAuthor[]
  copies       Copy[]
  loanRequests LoanRequest[]
  reservations Reservation[]

  @@index([title])
  @@index([categoryId])
  @@index([publisherId])
  @@index([isActive])
  @@map("books")
}

model BookAuthor {
  bookId   String @map("book_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  position Int    @default(1)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([bookId, authorId])
  @@map("book_authors")
}

model Copy {
  id         String     @id @default(uuid()) @db.Uuid
  bookId     String     @map("book_id") @db.Uuid
  copyCode   String     @map("copy_code")
  barcode    String     @unique
  status     CopyStatus @default(AVAILABLE)
  notes      String?
  acquiredAt DateTime?  @map("acquired_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  book           Book          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  loanRequests   LoanRequest[]
  loans          Loan[]

  @@unique([bookId, copyCode])
  @@index([bookId, status])
  @@index([status])
  @@map("copies")
}

// ---------------------------------------------------------------------------
// Circulación
// ---------------------------------------------------------------------------

model LoanRequest {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  bookId         String            @map("book_id") @db.Uuid
  assignedCopyId String?           @map("assigned_copy_id") @db.Uuid
  status         LoanRequestStatus @default(PENDING)
  requestedAt    DateTime          @default(now()) @map("requested_at")
  reviewedAt     DateTime?         @map("reviewed_at")
  reviewedById   String?           @map("reviewed_by_id") @db.Uuid
  notes          String?

  user         User  @relation("Requester", fields: [userId], references: [id], onDelete: Restrict)
  book         Book  @relation(fields: [bookId], references: [id], onDelete: Restrict)
  assignedCopy Copy? @relation(fields: [assignedCopyId], references: [id])
  reviewer     User? @relation("RequestReviewer", fields: [reviewedById], references: [id])
  loan         Loan?

  @@index([status, requestedAt])
  @@index([userId, status])
  @@index([bookId])
  @@map("loan_requests")
}

model Loan {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  copyId      String     @map("copy_id") @db.Uuid
  requestId   String?    @unique @map("request_id") @db.Uuid
  librarianId String?    @map("librarian_id") @db.Uuid
  loanedAt    DateTime   @default(now()) @map("loaned_at")
  dueOn       DateTime   @map("due_on") @db.Date
  returnedAt  DateTime?  @map("returned_at")
  status      LoanStatus @default(ACTIVE)
  notes       String?

  user      User         @relation("Borrower", fields: [userId], references: [id], onDelete: Restrict)
  copy      Copy         @relation(fields: [copyId], references: [id], onDelete: Restrict)
  request   LoanRequest? @relation(fields: [requestId], references: [id])
  librarian User?        @relation("LoanLibrarian", fields: [librarianId], references: [id])
  reminders ReminderJob[]

  @@index([userId, status])
  @@index([copyId, status])
  @@index([status, dueOn])
  @@map("loans")
}

model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  bookId        String            @map("book_id") @db.Uuid
  queuePosition Int               @map("queue_position")
  status        ReservationStatus @default(QUEUED)
  createdAt     DateTime          @default(now()) @map("created_at")
  notifiedAt    DateTime?         @map("notified_at")
  expiresAt     DateTime?         @map("expires_at")
  cancelledAt   DateTime?         @map("cancelled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([bookId, status, queuePosition])
  @@index([userId, status])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Notificaciones, recordatorios, settings, auditoría, Q10, IA
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type])
  @@map("notifications")
}

model ReminderJob {
  id           String            @id @default(uuid()) @db.Uuid
  loanId       String            @map("loan_id") @db.Uuid
  kind         ReminderKind
  scheduledFor DateTime          @map("scheduled_for")
  sentAt       DateTime?         @map("sent_at")
  status       ReminderJobStatus @default(SCHEDULED)
  error        String?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, kind])
  @@index([status, scheduledFor])
  @@map("reminder_jobs")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

model Q10SyncLog {
  id            String        @id @default(uuid()) @db.Uuid
  startedAt     DateTime      @default(now()) @map("started_at")
  finishedAt    DateTime?     @map("finished_at")
  status        Q10SyncStatus @default(STARTED)
  recordsOk     Int           @default(0) @map("records_ok")
  recordsFailed Int           @default(0) @map("records_failed")
  error         String?
  triggeredById String?       @map("triggered_by_id") @db.Uuid

  triggeredBy User? @relation(fields: [triggeredById], references: [id])

  @@index([startedAt])
  @@map("q10_sync_logs")
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tools        AiToolInvocation[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiToolInvocation {
  id            String   @id @default(uuid()) @db.Uuid
  messageId     String   @map("message_id") @db.Uuid
  toolName      String   @map("tool_name")
  permission    String
  allowed       Boolean
  arguments     Json?    @map("arguments")
  resultPreview String?  @map("result_preview")
  createdAt     DateTime @default(now()) @map("created_at")

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([toolName, allowed])
  @@map("ai_tool_invocations")
}
